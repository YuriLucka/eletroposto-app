@page "/admin/relatorios"
@layout AdminLayout
@using ev_charge_prototype.Pages.Admin.Components
@inject AppStateService State
@inject ISnackbar Snackbar

<PageHeader Icon="@Icons.Material.Filled.BarChart" Title="Relatórios"
            Subtitle="Indicadores financeiros e operacionais por período.">
    <div class="d-flex gap-2">
        <MudTooltip Text="Exportar como PDF">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="@(() => Exportar("PDF"))">PDF</MudButton>
        </MudTooltip>
        <MudTooltip Text="Exportar como planilha Excel">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.TableChart" OnClick="@(() => Exportar("Excel"))">Excel</MudButton>
        </MudTooltip>
        <MudTooltip Text="Exportar como CSV">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Description" OnClick="@(() => Exportar("CSV"))">CSV</MudButton>
        </MudTooltip>
    </div>
</PageHeader>

<MudPaper Class="pa-1 mb-4" Elevation="0" Style="background:transparent;">
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4" ActivePanelIndex="_periodoIndex" ActivePanelIndexChanged="OnPeriodoChanged">
        <MudTabPanel Text="Diário" Icon="@Icons.Material.Filled.Today" />
        <MudTabPanel Text="Semanal" Icon="@Icons.Material.Filled.DateRange" />
        <MudTabPanel Text="Mensal" Icon="@Icons.Material.Filled.CalendarMonth" />
        <MudTabPanel Text="Anual" Icon="@Icons.Material.Filled.Event" />
    </MudTabs>
</MudPaper>

@if (_periodoIndex != 1)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Info" Dense="true">
        Dados de exemplo — apenas o período <b>Semanal</b> usa os dados reais simulados (@nameof(MockDataStore.FaturamentoUltimos7Dias)). Os demais períodos são projeções ilustrativas para fins de protótipo.
    </MudAlert>
}

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Icon="@Icons.Material.Filled.AttachMoney" Title="Faturamento total" Value="@($"R$ {_faturamentoTotal:N2}")" Color="Color.Success" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Icon="@Icons.Material.Filled.Bolt" Title="kWh vendidos" Value="@($"{_kwhTotal:N1}")" Color="Color.Info" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Icon="@Icons.Material.Filled.BatteryChargingFull" Title="Sessões" Value="@_sessoesTotal.ToString()" Color="Color.Primary" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Icon="@Icons.Material.Filled.LocalOffer" Title="Ticket médio" Value="@($"R$ {_ticketMedio:N2}")" Color="Color.Secondary" SubText="faturamento / sessões" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Icon="@Icons.Material.Filled.ElectricBolt" Title="Custo estimado de energia" Value="@($"R$ {_custoEnergia:N2}")" Color="Color.Warning" SubText="kWh × R$ 0,65 / kWh" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Icon="@Icons.Material.Filled.Savings" Title="Margem estimada" Value="@($"R$ {_margem:N2}")" Color="Color.Tertiary" SubText="faturamento − custo de energia" />
    </MudItem>
</MudGrid>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <div class="d-flex align-center mb-3">
                <div class="admin-section-icon mr-3"><MudIcon Icon="@Icons.Material.Filled.ShowChart" /></div>
                <MudText Typo="Typo.h6">Faturamento no período</MudText>
            </div>
            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_series" ChartLabels="@_labels" ChartOptions="@_chartOptions" Width="100%" Height="280px" />
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex align-center mb-3">
                <div class="admin-section-icon mr-3"><MudIcon Icon="@Icons.Material.Filled.EvStation" /></div>
                <MudText Typo="Typo.h6">Utilização por carregador</MudText>
            </div>
            @foreach (var item in _utilizacao)
            {
                <div class="d-flex align-center mb-3">
                    <MudText Typo="Typo.body2" Style="width:150px;">@item.Codigo</MudText>
                    <div class="util-bar-track mr-3">
                        <div class="util-bar-fill" style="width:@(item.Percentual)%;"></div>
                    </div>
                    <MudText Typo="Typo.body2" Style="width:48px;text-align:right;">@item.Percentual%</MudText>
                </div>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <div class="d-flex align-center mb-3">
                <div class="admin-section-icon mr-3"><MudIcon Icon="@Icons.Material.Filled.Schedule" /></div>
                <MudText Typo="Typo.h6">Demanda por horário</MudText>
            </div>
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-2" Icon="@Icons.Material.Filled.TrendingUp">
                Pico de demanda: <b>18h – 20h</b> (retorno do trabalho)
            </MudAlert>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.TrendingDown">
                Menor demanda: <b>03h – 06h</b> (madrugada)
            </MudAlert>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Valores ilustrativos com base no padrão típico de uso do eletroposto.</MudText>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex align-center mb-3">
                <div class="admin-section-icon mr-3"><MudIcon Icon="@Icons.Material.Filled.AttachMoney" /></div>
                <MudText Typo="Typo.h6">Receita por carregador</MudText>
            </div>
            <MudTable Items="@_receitaPorCarregador" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Carregador</MudTh>
                    <MudTh Style="text-align:right;">Receita</MudTh>
                    <MudTh Style="text-align:right;">%</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Carregador">@context.Codigo</MudTd>
                    <MudTd DataLabel="Receita" Style="text-align:right;">R$ @context.Valor.ToString("N2")</MudTd>
                    <MudTd DataLabel="%" Style="text-align:right;">@context.Percentual.ToString("N0")%</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private int _periodoIndex = 1; // Semanal por padrão (dados reais)

    private void OnPeriodoChanged(int novoIndex)
    {
        _periodoIndex = novoIndex;
        Recalcular();
    }

    private decimal _faturamentoTotal;
    private double _kwhTotal;
    private int _sessoesTotal;
    private decimal _ticketMedio;
    private decimal _custoEnergia;
    private decimal _margem;
    private const decimal CustoMedioPorKwh = 0.65m;

    private List<ChartSeries<double>> _series = new();
    private string[] _labels = Array.Empty<string>();
    private readonly BarChartOptions _chartOptions = new()
    {
        YAxisToStringFunc = y => $"R$ {y:N0}",
    };

    private record UtilizacaoItem(string Codigo, int Percentual);
    private List<UtilizacaoItem> _utilizacao = new();

    private record ReceitaItem(string Codigo, decimal Valor, decimal Percentual);
    private List<ReceitaItem> _receitaPorCarregador = new();

    protected override void OnInitialized() => Recalcular();

    private void Recalcular()
    {
        var semanal = State.Data.FaturamentoUltimos7Dias;
        var mediaDiaria = semanal.Count == 0 ? 0 : semanal.Average(f => f.Faturamento);
        var mediaKwh = semanal.Count == 0 ? 0 : semanal.Average(f => f.KwhVendidos);
        var mediaSessoes = semanal.Count == 0 ? 0 : semanal.Average(f => f.Sessoes);

        List<FaturamentoDia> periodo;
        switch (_periodoIndex)
        {
            case 0: // Diário — último dia real
                periodo = semanal.TakeLast(1).ToList();
                _labels = new[] { "Hoje" };
                break;
            case 2: // Mensal — ilustrativo: 4 semanas
                periodo = Enumerable.Range(1, 4).Select(i => new FaturamentoDia
                {
                    Data = DateTime.Today.AddDays(-7 * (4 - i)),
                    Faturamento = mediaDiaria * 7 * (0.9m + (decimal)i * 0.04m),
                    KwhVendidos = mediaKwh * 7 * (0.9 + i * 0.04),
                    Sessoes = (int)(mediaSessoes * 7 * (0.9 + i * 0.04)),
                }).ToList();
                _labels = new[] { "Sem. 1", "Sem. 2", "Sem. 3", "Sem. 4" };
                break;
            case 3: // Anual — ilustrativo: 12 meses
                periodo = Enumerable.Range(1, 12).Select(i => new FaturamentoDia
                {
                    Data = DateTime.Today.AddMonths(-(12 - i)),
                    Faturamento = mediaDiaria * 30 * (0.85m + (decimal)i * 0.02m),
                    KwhVendidos = mediaKwh * 30 * (0.85 + i * 0.02),
                    Sessoes = (int)(mediaSessoes * 30 * (0.85 + i * 0.02)),
                }).ToList();
                _labels = Enumerable.Range(1, 12).Select(i => DateTime.Today.AddMonths(-(12 - i)).ToString("MMM")).ToArray();
                break;
            default: // Semanal — dados reais
                periodo = semanal;
                _labels = semanal.Select(f => f.Data.ToString("dd/MM")).ToArray();
                break;
        }

        _faturamentoTotal = periodo.Sum(f => f.Faturamento);
        _kwhTotal = periodo.Sum(f => f.KwhVendidos);
        _sessoesTotal = periodo.Sum(f => f.Sessoes);
        _ticketMedio = _sessoesTotal == 0 ? 0 : _faturamentoTotal / _sessoesTotal;
        _custoEnergia = (decimal)_kwhTotal * CustoMedioPorKwh;
        _margem = _faturamentoTotal - _custoEnergia;

        _series = new List<ChartSeries<double>>
        {
            new() { Name = "Faturamento (R$)", Data = periodo.Select(f => (double)f.Faturamento).ToArray() }
        };

        var carregadores = State.Data.Estacoes.SelectMany(e => e.Carregadores).ToList();
        _utilizacao = carregadores.Select(c => new UtilizacaoItem(c.Codigo, UtilizacaoIlustrativa(c))).ToList();

        var pesos = carregadores.Select(c => c.Corrente == TipoCorrente.DC ? 2.2 : 1.0).ToList();
        var pesoTotal = pesos.Sum();
        _receitaPorCarregador = carregadores.Zip(pesos, (c, p) =>
        {
            var valor = pesoTotal == 0 ? 0 : _faturamentoTotal * (decimal)(p / pesoTotal);
            var pct = _faturamentoTotal == 0 ? 0 : valor / _faturamentoTotal * 100;
            return new ReceitaItem(c.Codigo, valor, pct);
        }).OrderByDescending(r => r.Valor).ToList();
    }

    private static int UtilizacaoIlustrativa(Carregador c) => c.Status switch
    {
        StatusCarregador.EmUso => 82,
        StatusCarregador.Disponivel => c.Corrente == TipoCorrente.DC ? 58 : 34,
        StatusCarregador.Manutencao => 12,
        _ => 4,
    };

    private void Exportar(string formato) => Snackbar.Add($"Exportação em {formato} simulada — protótipo.", Severity.Info);
}
