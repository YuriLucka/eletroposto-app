@page "/veiculo"
@inject AppStateService State

<MudText Typo="Typo.h5" Class="mb-1">Meu veículo</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Gerencie seus veículos e o limite de carga de cada um.</MudText>

<MudStack Spacing="3" Class="mb-4">
    @foreach (var v in State.Data.UsuarioAtual.Veiculos)
    {
        <MudCard Elevation="2">
            <MudCardContent Class="pa-4">
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                            <MudIcon Icon="@Format.VeiculoIcone(v.Tipo)" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.subtitle1"><b>@v.Marca @v.Modelo</b></MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@v.Ano · @TipoTexto(v.Tipo)</MudText>
                        </div>
                    </MudStack>
                    @if (v.Principal)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Star">Principal</MudChip>
                    }
                </MudStack>

                <MudStack Row Justify="Justify.SpaceBetween" Class="mt-2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Format.ConectorIcone(v.Conector)" Size="Size.Small" style="vertical-align:middle;" /> Conector</MudText>
                    <MudText Typo="Typo.body2">@v.Conector</MudText>
                </MudStack>
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Icons.Material.Filled.BatteryFull" Size="Size.Small" style="vertical-align:middle;" /> Capacidade da bateria</MudText>
                    <MudText Typo="Typo.body2">@v.CapacidadeBateriaKwh.ToString("0.0") kWh</MudText>
                </MudStack>

                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2">Limite de carga: <b>@v.LimiteCargaPercentual%</b></MudText>
                <MudStack Row Spacing="2">
                    @foreach (var pct in _limites)
                    {
                        <MudChip T="string" Color="@(v.LimiteCargaPercentual == pct ? Color.Primary : Color.Default)" OnClick="@(() => v.LimiteCargaPercentual = pct)">@pct%</MudChip>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
</MudStack>

@if (!_mostrarForm)
{
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth Size="Size.Large" Class="py-2" StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="@(() => _mostrarForm = true)">
        ADICIONAR VEÍCULO
    </MudButton>
}
else
{
    <MudCard Elevation="2">
        <MudCardContent Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Novo veículo</b></MudText>
            <MudTextField T="string" Label="Marca" @bind-Value="_marca" Required Class="mb-3" />
            <MudTextField T="string" Label="Modelo" @bind-Value="_modelo" Required Class="mb-3" />
            <MudNumericField T="int" Label="Ano" @bind-Value="_ano" Min="1990" Max="2100" Class="mb-3" />
            <MudSelect T="TipoVeiculo" Label="Tipo" @bind-Value="_tipo" Class="mb-3">
                <MudSelectItem T="TipoVeiculo" Value="TipoVeiculo.Eletrico">Elétrico</MudSelectItem>
                <MudSelectItem T="TipoVeiculo" Value="TipoVeiculo.HibridoPlugIn">Híbrido plug-in</MudSelectItem>
            </MudSelect>
            <MudSelect T="TipoConector" Label="Conector" @bind-Value="_conector" Class="mb-3">
                <MudSelectItem T="TipoConector" Value="TipoConector.CCS2">CCS2</MudSelectItem>
                <MudSelectItem T="TipoConector" Value="TipoConector.Tipo2">Tipo 2</MudSelectItem>
                <MudSelectItem T="TipoConector" Value="TipoConector.CHAdeMO">CHAdeMO</MudSelectItem>
            </MudSelect>
            <MudNumericField T="double" Label="Capacidade da bateria (kWh)" @bind-Value="_capacidade" Min="0" Class="mb-3" />

            <MudStack Row Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Text" FullWidth OnClick="Cancelar">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth StartIcon="@Icons.Material.Filled.Check" OnClick="Adicionar" Disabled="@(string.IsNullOrWhiteSpace(_marca) || string.IsNullOrWhiteSpace(_modelo))">
                    SALVAR
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>
}

@code {
    private readonly int[] _limites = { 70, 80, 90, 100 };

    private bool _mostrarForm;
    private string _marca = "";
    private string _modelo = "";
    private int _ano = DateTime.Today.Year;
    private TipoVeiculo _tipo = TipoVeiculo.Eletrico;
    private TipoConector _conector = TipoConector.CCS2;
    private double _capacidade = 40;

    private static string TipoTexto(TipoVeiculo t) => t switch
    {
        TipoVeiculo.Eletrico => "Elétrico",
        TipoVeiculo.HibridoPlugIn => "Híbrido plug-in",
        _ => t.ToString(),
    };

    private void Adicionar()
    {
        State.Data.UsuarioAtual.Veiculos.Add(new Veiculo
        {
            Id = $"v-{Guid.NewGuid().ToString()[..8]}",
            Marca = _marca,
            Modelo = _modelo,
            Ano = _ano,
            Tipo = _tipo,
            Conector = _conector,
            CapacidadeBateriaKwh = _capacidade,
            LimiteCargaPercentual = 80,
            Principal = State.Data.UsuarioAtual.Veiculos.Count == 0,
        });
        Cancelar();
    }

    private void Cancelar()
    {
        _mostrarForm = false;
        _marca = "";
        _modelo = "";
        _ano = DateTime.Today.Year;
        _tipo = TipoVeiculo.Eletrico;
        _conector = TipoConector.CCS2;
        _capacidade = 40;
    }
}
