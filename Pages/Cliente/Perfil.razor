@page "/perfil"
@inject AppStateService State
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4">Perfil</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Class="mb-3">
        <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled" Style="font-size:1.4rem;">
            @Iniciais
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h6"><b>@Usuario.Nome</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Usuario.Email</MudText>
        </div>
    </MudStack>
    <MudDivider Class="mb-3" />
    <MudStack Spacing="2">
        <MudStack Row Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" style="vertical-align:middle;" /> CPF</MudText>
            <MudText Typo="Typo.body2">@Usuario.Cpf</MudText>
        </MudStack>
        <MudStack Row Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" style="vertical-align:middle;" /> Telefone</MudText>
            <MudText Typo="Typo.body2">@Usuario.Telefone</MudText>
        </MudStack>
    </MudStack>
</MudPaper>

<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="6">
        <MudPaper Class="pa-3" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Saldo carteira</MudText>
            <MudText Typo="Typo.h6">@Format.Moeda(Usuario.SaldoCarteira)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="pa-3" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.Loyalty" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Pontos de fidelidade</MudText>
            <MudText Typo="Typo.h6">@Usuario.PontosFidelidade pts</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
    1 ponto a cada R$ 1 gasto — em breve, troca de pontos por desconto.
</MudText>

<MudStack Spacing="2" Class="mb-4">
    <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Material.Filled.DirectionsCar" Href="/veiculo">Meu veículo</MudButton>
    <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Material.Filled.CardMembership" Href="/planos">Planos</MudButton>
    <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Material.Filled.NotificationsNone" Href="/notificacoes">Notificações</MudButton>
    <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Material.Filled.SupportAgent" Href="/suporte">Suporte</MudButton>
</MudStack>

<MudButton Variant="Variant.Text" Color="Color.Error" FullWidth StartIcon="@Icons.Material.Filled.Logout" OnClick="Sair">Sair</MudButton>

@code {
    private Usuario Usuario => State.Data.UsuarioAtual;
    private string Iniciais => string.Concat(Usuario.Nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpperInvariant();

    private void Sair() => Snackbar.Add("Sessão encerrada (protótipo sem autenticação real).", Severity.Info);
}
