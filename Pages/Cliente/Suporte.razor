@page "/suporte"
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-1">Precisa de ajuda?</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Selecione o assunto e conte o que aconteceu.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Categoria</b></MudText>
    <MudRadioGroup @bind-Value="_categoria" T="string">
        @foreach (var cat in _categorias)
        {
            <MudRadio Value="@cat" Color="Color.Primary" Dense="true">@cat</MudRadio>
        }
    </MudRadioGroup>
</MudPaper>

<MudTextField T="string" Label="Descreva o problema" @bind-Value="_mensagem" Lines="4" Variant="Variant.Outlined" Class="mb-4" />

<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Size="Size.Large" Class="py-3" StartIcon="@Icons.Material.Filled.SupportAgent" OnClick="Enviar">
    FALAR COM SUPORTE
</MudButton>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 d-block text-center">
    <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" style="vertical-align:middle;" /> Integração com WhatsApp — em breve.
</MudText>

@code {
    private readonly string[] _categorias =
    {
        "Problema para iniciar recarga",
        "Problema no pagamento",
        "Carregador não funcionando",
        "Problema com reserva",
        "Cobrança incorreta",
        "Outro",
    };

    private string _categoria = "Problema para iniciar recarga";
    private string _mensagem = "";

    private void Enviar() => Snackbar.Add("Chamado registrado. Em breve, integração com WhatsApp.", Severity.Success);
}
