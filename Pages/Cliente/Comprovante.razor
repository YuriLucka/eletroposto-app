@page "/comprovante/{id}"
@inject AppStateService State
@inject ISnackbar Snackbar
@implements IDisposable

@if (Transacao is null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Comprovante não encontrado.</MudAlert>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">Comprovante</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@Format.DataHora(Transacao.Data)</MudText>

    @if (SessaoPendente is { } pendente)
    {
        <MudAlert Severity="@(pendente.ValorOcupacaoAcumulado > 0 ? Severity.Warning : Severity.Info)"
                  Icon="@Icons.Material.Filled.DirectionsCarFilled" Class="mb-4">
            <MudText Typo="Typo.body2">
                Veículo ainda conectado ao carregador <b>@pendente.CarregadorCodigo</b>.
                @if (pendente.ValorOcupacaoAcumulado > 0)
                {
                    <text> Taxa de permanência acumulada: <b>@Format.Moeda(pendente.ValorOcupacaoAcumulado)</b> (@Format.Moeda(pendente.TaxaOcupacaoPorMinuto)/min).</text>
                }
                else
                {
                    <text> Retire o veículo em breve para evitar cobrança de permanência.</text>
                }
            </MudText>
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth Class="mb-4 py-2"
                   StartIcon="@Icons.Material.Filled.DirectionsCar" OnClick="ConfirmarRetirada">
            CONFIRMAR RETIRADA DO VEÍCULO
        </MudButton>
    }

    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="pa-4">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1"><b>@Transacao.EstacaoNome</b></MudText>
                </MudStack>
                <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small">Pago</MudChip>
            </MudStack>

            <MudStack Spacing="2">
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Icons.Material.Filled.EvStation" Size="Size.Small" style="vertical-align:middle;" /> Carregador</MudText>
                    <MudText Typo="Typo.body1">@Transacao.CarregadorCodigo</MudText>
                </MudStack>
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" style="vertical-align:middle;" /> Energia</MudText>
                    <MudText Typo="Typo.body1">@Transacao.EnergiaKwh.ToString("0.0") kWh</MudText>
                </MudStack>
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" style="vertical-align:middle;" /> Duração</MudText>
                    <MudText Typo="Typo.body1">@Transacao.DuracaoMinutos min</MudText>
                </MudStack>
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Format.FormaPagamentoIcone(Transacao.FormaPagamento)" Size="Size.Small" style="vertical-align:middle;" /> Forma de pagamento</MudText>
                    <MudText Typo="Typo.body1">@AppStateService.DescreverFormaPagamento(Transacao.FormaPagamento)</MudText>
                </MudStack>
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary"><MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" style="vertical-align:middle;" /> Comprovante</MudText>
                    <MudText Typo="Typo.body1">@Transacao.ComprovanteId</MudText>
                </MudStack>
                <MudDivider Class="my-1" />
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">Valor pago</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary"><b>@Format.Moeda(Transacao.Valor)</b></MudText>
                </MudStack>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <MudStack Row Spacing="2" Class="mb-3">
        <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Material.Filled.Share" OnClick="EmBreve">Compartilhar</MudButton>
        <MudButton Variant="Variant.Outlined" FullWidth StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="EmBreve">Baixar PDF</MudButton>
    </MudStack>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Size="Size.Large" Class="py-3" StartIcon="@Icons.Material.Filled.History" Href="historico">
        VOLTAR AO HISTÓRICO
    </MudButton>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private Transacao? Transacao => State.Data.Transacoes.FirstOrDefault(t => t.Id == Id);

    private SessaoRecarga? SessaoPendente =>
        State.SessaoAtiva is { Status: StatusSessao.Finalizada, VeiculoRetirado: false } s
        && Transacao is not null && s.CarregadorCodigo == Transacao.CarregadorCodigo
            ? s : null;

    private void EmBreve() => Snackbar.Add("Em breve.", Severity.Info);

    private void ConfirmarRetirada()
    {
        State.ConfirmarRetiradaVeiculo();
        Snackbar.Add("Veículo retirado. Carregador liberado.", Severity.Success);
    }

    protected override void OnInitialized() => State.OnChange += Rerender;
    private void Rerender() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChange -= Rerender;
}
