@page "/"
@inject AppStateService State

<div class="home-hero mb-3">
    <div class="home-hero-blob home-hero-blob-1"></div>
    <div class="home-hero-blob home-hero-blob-2"></div>
    <MudIcon Icon="@Icons.Material.Filled.EvStation" Class="home-hero-icon" />
    <div class="home-hero-text">
        <MudText Typo="Typo.subtitle2" Class="home-hero-title">Eletroposto Biguaçu</MudText>
        <MudText Typo="Typo.caption" Class="home-hero-caption">Recarga rápida com energia limpa</MudText>
    </div>
</div>

<MudText Typo="Typo.h5" Class="mb-4">Olá, @PrimeiroNome</MudText>

<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="6">
        <MudPaper Class="pa-3" Elevation="1">
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Saldo carteira</MudText>
            </MudStack>
            <MudText Typo="Typo.h6">@Format.Moeda(Usuario.SaldoCarteira)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="pa-3" Elevation="1">
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudIcon Icon="@(VeiculoPrincipal is null ? Icons.Material.Filled.DirectionsCar : Format.VeiculoIcone(VeiculoPrincipal.Tipo))" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Veículo principal</MudText>
            </MudStack>
            <MudText Typo="Typo.h6">@(VeiculoPrincipal is null ? "—" : $"{VeiculoPrincipal.Marca} {VeiculoPrincipal.Modelo}")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-3" Elevation="1">
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Eletroposto mais próximo</MudText>
            </MudStack>
            <MudText Typo="Typo.h6">@MaisProximo.Nome — @Format.Distancia(MaisProximo.DistanciaMetros)</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="py-3 mb-4"
           StartIcon="@Icons.Material.Filled.ElectricBolt" Href="mapa">
    CARREGAR AGORA
</MudButton>

<MudGrid Spacing="2">
    <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth Href="mapa" StartIcon="@Icons.Material.Filled.Map" Style="white-space:nowrap;">Encontrar</MudButton></MudItem>
    <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth Href="reservas" StartIcon="@Icons.Material.Filled.CalendarMonth">Reservas</MudButton></MudItem>
    <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth Href="historico" StartIcon="@Icons.Material.Filled.History">Histórico</MudButton></MudItem>
    <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth Href="historico" StartIcon="@Icons.Material.Filled.Payments">Pagamentos</MudButton></MudItem>
    <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth Href="veiculo" StartIcon="@Icons.Material.Filled.DirectionsCar">Meu veículo</MudButton></MudItem>
    <MudItem xs="6"><MudButton Variant="Variant.Outlined" FullWidth Href="suporte" StartIcon="@Icons.Material.Filled.SupportAgent">Suporte</MudButton></MudItem>
</MudGrid>

@code {
    private Usuario Usuario => State.Data.UsuarioAtual;
    private string PrimeiroNome => Usuario.Nome.Split(' ')[0];
    private Veiculo? VeiculoPrincipal => Usuario.Veiculos.FirstOrDefault(v => v.Principal) ?? Usuario.Veiculos.FirstOrDefault();
    private Estacao MaisProximo => State.Data.Estacoes.OrderBy(e => e.DistanciaMetros).First();
}
