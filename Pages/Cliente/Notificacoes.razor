@page "/notificacoes"
@inject AppStateService State

<MudText Typo="Typo.h5" Class="mb-1">Notificações</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Avisos sobre reservas, recargas e pagamentos.</MudText>

@if (!State.Data.Notificacoes.Any())
{
    <MudAlert Severity="Severity.Info">Nenhuma notificação por aqui.</MudAlert>
}
else
{
    <MudStack Spacing="2">
        @foreach (var n in State.Data.Notificacoes.OrderByDescending(n => n.DataHora))
        {
            <MudPaper Class="pa-4" Elevation="@(n.Lida ? 1 : 3)" Style="@(n.Lida ? "" : "border-left:4px solid var(--mud-palette-primary);")" @onclick="@(() => MarcarLida(n))">
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Start">
                        <MudText Style="font-size:1.4rem; line-height:1;">@n.Icone</MudText>
                        <div>
                            <MudText Typo="Typo.subtitle2">@(n.Lida ? n.Titulo : new MarkupString($"<b>{n.Titulo}</b>"))</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@n.Mensagem</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">@Format.DataHora(n.DataHora)</MudText>
                        </div>
                    </MudStack>
                    @if (!n.Lida)
                    {
                        <div style="width:10px;height:10px;border-radius:50%;background:var(--mud-palette-primary);margin-top:6px;flex-shrink:0;"></div>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {
    private void MarcarLida(Notificacao n) => n.Lida = true;
}
